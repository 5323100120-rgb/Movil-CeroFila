<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FilaCero.Mobile.Pages.TriagePage" Title="Triaje">
 <ScrollView>
  <VerticalStackLayout Padding="22" Spacing="15">
   <Label Text="PASO 02" Style="{StaticResource Eyebrow}" />
   <Label Text="Cuestionario de triaje" Style="{StaticResource BigTitle}" />
   <Label Text="Responde las preguntas. La clasificación no equivale a un diagnóstico médico." Style="{StaticResource SubText}" />
   <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 16" Padding="18">
    <VerticalStackLayout Spacing="16">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Grid.Column="0" Text="¿Presentas dolor torácico agudo?" VerticalOptions="Center" /><Switch x:Name="ChestPain" Grid.Column="1" /></Grid>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Grid.Column="0" Text="¿Tienes dificultad para respirar?" VerticalOptions="Center" /><Switch x:Name="Breathing" Grid.Column="1" /></Grid>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Grid.Column="0" Text="¿Has perdido el conocimiento?" VerticalOptions="Center" /><Switch x:Name="Unconscious" Grid.Column="1" /></Grid>
     <BoxView HeightRequest="1" Color="{StaticResource Line}" />
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Grid.Column="0" Text="¿Tienes fiebre?" VerticalOptions="Center" /><Switch x:Name="Fever" Grid.Column="1" /></Grid>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Grid.Column="0" Text="¿Presentas dolor intenso?" VerticalOptions="Center" /><Switch x:Name="SeverePain" Grid.Column="1" /></Grid>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Label Grid.Column="0" Text="¿Tienes mareos?" VerticalOptions="Center" /><Switch x:Name="Dizziness" Grid.Column="1" /></Grid>
     <Label Text="Presión arterial (opcional)" FontAttributes="Bold" FontSize="15" />
     <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <VerticalStackLayout Grid.Column="0"><Label Text="Sistólica" Style="{StaticResource FieldLabel}"/><Entry x:Name="Systolic" Keyboard="Numeric" Placeholder="140" MaxLength="3" /></VerticalStackLayout>
      <VerticalStackLayout Grid.Column="1"><Label Text="Diastólica" Style="{StaticResource FieldLabel}"/><Entry x:Name="Diastolic" Keyboard="Numeric" Placeholder="90" MaxLength="3" /></VerticalStackLayout>
     </Grid>
     <Label Text="Descripción adicional (opcional)" Style="{StaticResource FieldLabel}" />
     <Editor x:Name="Description" Placeholder="Describe tus síntomas" HeightRequest="100" MaxLength="400" />
     <Label x:Name="TriageResult" Text="El personal de la clínica debe verificar toda prioridad." Style="{StaticResource WarnText}" />
     <Button x:Name="SendButton" Text="Evaluar mis respuestas" Clicked="SendClicked" />
    </VerticalStackLayout>
   </Border>
   <Border BackgroundColor="#FFF1F2" Stroke="#F0CBD0" StrokeShape="RoundRectangle 12" Padding="14">
    <Label Text="Si presentas síntomas graves, no esperes una ficha digital: solicita atención urgente." TextColor="{StaticResource Danger}" FontSize="13" />
   </Border>
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
